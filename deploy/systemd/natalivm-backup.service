[Unit]
Description=VUMEXCLUSIVE Supabase backup and integrity check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/natalivm/current
Environment=NODE_ENV=production
ExecStart=/srv/natalivm/current/deploy/run-backup.sh /srv/natalivm/backups/database
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/srv/natalivm/backups
