[Unit]
Description=VUMEXCLUSIVE CRM
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=natalivm
Group=natalivm
WorkingDirectory=/srv/natalivm/current
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/srv/natalivm/current/.next

[Install]
WantedBy=multi-user.target
