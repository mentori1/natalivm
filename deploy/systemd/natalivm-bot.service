[Unit]
Description=VUMEXCLUSIVE Telegram bot
After=network-online.target natalivm-crm.service
Wants=network-online.target

[Service]
Type=simple
User=natalivm
Group=natalivm
WorkingDirectory=/srv/natalivm/current
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run bot:poll
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
