// Схема БД мини-CRM преподавателя танцев.
// Прототип на SQLite; при деплое меняется только datasource на Postgres.
// Статусы хранятся как строки (TEXT) — SQLite не поддерживает enum,
// плюс это удобнее для бизнес-логики, которая со временем меняется.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Клиент (ученик)
model Client {
  id              Int       @id @default(autoincrement())
  fullName        String
  phone           String?
  telegram        String?
  telegramUserId  String?   @unique // стабильный Telegram ID для business-бота
  instagram       String?
  birthDate       DateTime?
  firstContact    DateTime  @default(now()) // дата первого контакта
  source          String? // источник (Instagram, Telegram, сарафан, блогер…)
  sourceDetail    String? // от кого именно: имя блогера, канал, кампания
  // lead | trial | active | expired | inactive | barter
  status          String    @default("lead")
  request         String? // с каким запросом пришёл (свободный текст)
  // «Рекомендации для преподавателя» — НЕ диагнозы, а что учитывать на занятии
  recommendations String?
  lastVisitAt     DateTime? // дата последнего занятия (денормализовано для скорости)
  hasTrainer      Boolean   @default(false) // купил ли тренажёр для танцев
  trainerPurchasedAt DateTime? // когда купил тренажёр
  trainerProfit   Int? // прибыль с этой продажи тренажёра, ₽ (фиксируется в момент продажи)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscriptions Subscription[]
  attendances   Attendance[]
  notes         Note[]
  goals         ClientGoal[]
  singleVisits  SingleVisit[]
  telegramConversations TelegramConversation[]
}

/// Разовое или пробное посещение (без абонемента, оплата за визит)
model SingleVisit {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  type      String // online | offline
  kind      String // trial (пробное) | single (разовое)
  tariffName String? // название тарифа на момент продажи
  amount    Float    @default(0)
  createdAt DateTime @default(now())

  @@index([clientId])
}

/// Абонемент. Универсальная модель: любое число занятий (от 4),
/// онлайн/офлайн, истекает по сроку или по занятиям.
model Subscription {
  id             Int       @id @default(autoincrement())
  clientId       Int
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type           String // online | offline
  tariffName     String? // название тарифа на момент продажи
  purchasedAt    DateTime  @default(now())
  totalLessons   Int // куплено занятий
  usedLessons    Int       @default(0) // использовано занятий
  pricePerLesson Float     @default(0) // цена за одно занятие, ₽
  expiresAt      DateTime // дата окончания срока (обычно +1.5 мес)
  frozen         Boolean   @default(false)
  frozenUntil    DateTime? // до какого числа заморожен
  freezeReason   String? // причина заморозки
  // active | ending | finished_lessons | finished_term | frozen
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  attendances Attendance[]
  visits      SubscriptionVisit[]

  @@index([clientId])
}

/// Прайс-лист: тарифы, которые подставляются в новые продажи.
/// Старые абонементы/визиты хранят свои суммы отдельно и не пересчитываются.
model PriceItem {
  id         Int      @id @default(autoincrement())
  name       String
  kind       String // subscription | single | trial
  type       String // online | offline
  price      Int
  minLessons Int?
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([kind, type])
}

/// Отмеченный день посещения по абонементу (ручная отметка в календаре,
/// без привязки к занятию в расписании)
model SubscriptionVisit {
  id             Int          @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  date           DateTime // день посещения (00:00 UTC)
  createdAt      DateTime     @default(now())

  @@unique([subscriptionId, date])
  @@index([subscriptionId])
}

/// Занятие (одно событие в расписании)
model Lesson {
  id        Int      @id @default(autoincrement())
  title     String? // напр. «Оффлайн группа»
  type      String // online | offline
  format    String   @default("group") // group | individual
  startsAt  DateTime // дата и время начала
  capacity  Int? // сколько мест
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances Attendance[]

  @@index([startsAt])
}

/// Запись клиента на занятие + факт посещения.
/// status: enrolled (записан) | present (была) | absent (не была)
model Attendance {
  id             Int           @id @default(autoincrement())
  lessonId       Int
  lesson         Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  clientId       Int
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status         String        @default("enrolled")
  subscriptionId Int? // с какого абонемента списали занятие
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([lessonId, clientId])
  @@index([clientId])
  @@index([lessonId])
}

/// Журнал заметок преподавателя по клиенту
model Note {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([clientId])
}

/// Цели клиента (уверенность, работа с телом и т.п.)
model ClientGoal {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([clientId])
}

/// Расход (аренда зала и пр.) — для управленческого учёта
model Expense {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  date      DateTime @default(now())
  category  String? // аренда, реклама, прочее
  createdAt DateTime @default(now())
}

/// Подключение бота к личному аккаунту через Telegram Business.
model TelegramBusinessConnection {
  id              String   @id // business_connection_id от Telegram
  ownerTelegramId String
  ownerUsername   String?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversations TelegramConversation[]
}

/// Состояние сценария записи в одном личном Telegram-чате.
model TelegramConversation {
  id                   Int      @id @default(autoincrement())
  businessConnectionId String
  businessConnection   TelegramBusinessConnection @relation(fields: [businessConnectionId], references: [id], onDelete: Cascade)
  telegramChatId       String
  telegramUserId       String?
  username             String?
  displayName          String?
  clientId             Int?
  client               Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  state                String   @default("idle") // idle | awaiting_type | options_sent | booked | human_takeover | manual_followup | closed
  preferredType        String? // online | offline
  lastIncomingAt       DateTime?
  lastOwnerCommandAt   DateTime?
  lastBotMessageAt     DateTime?
  reminderSentAt       DateTime?
  followupDueAt        DateTime?
  stopped              Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tasks BotTask[]

  @@unique([businessConnectionId, telegramChatId])
  @@index([clientId])
  @@index([followupDueAt, state])
}

/// Служебная задача Наталье/администратору, например ручной дожим через 48 часов.
model BotTask {
  id                 Int      @id @default(autoincrement())
  conversationId     Int
  conversation       TelegramConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type               String   @default("manual_followup")
  status             String   @default("pending") // pending | notified | done | cancelled
  dueAt              DateTime
  notificationSentAt DateTime?
  completedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status, dueAt])
}

/// Обработанные Telegram updates — защита от повторной обработки.
model TelegramUpdate {
  id          String   @id
  processedAt DateTime @default(now())
}
