# Скопируйте значения в .env (база) и .env.local (вход) и подставьте свои.

# ── База данных (Supabase / PostgreSQL) ──
# Supabase → Connect → Session pooler (порт 5432):
DATABASE_URL="postgresql://postgres.ССЫЛКА:ПАРОЛЬ@aws-0-РЕГИОН.pooler.supabase.com:5432/postgres"

# ── Вход преподавателя ──
APP_PASSWORD="придумайте-пароль-для-входа"
# AUTH_SECRET — длинная случайная строка для подписи сессии (openssl rand -hex 32)
AUTH_SECRET="смените-на-случайную-строку"

# ── Клиентский Telegram-бот ──
# Для локального теста значения кладутся в .env.bot.local, не в Git.
TELEGRAM_BOT_TOKEN="токен-из-BotFather"
TELEGRAM_ADMIN_IDS="telegram-id-данилы,telegram-id-натальи"
# По умолчанию очередь Telegram сохраняется. Значение 1 допустимо только для отдельного тестового бота.
TELEGRAM_DROP_PENDING_UPDATES="0"
# Нужен только если вместо постоянного polling используется webhook.
TELEGRAM_WEBHOOK_SECRET="длинная-случайная-строка"
